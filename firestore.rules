rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Administrator listing and editing is disabled until the rollout is ready.
      // allow get: if isSignedIn() && (request.auth.uid == userId || isAuthorised('ADMINISTRATOR'));
      // allow list: if isAuthorised('ADMINISTRATOR');
      // allow update: if isAuthorised('ADMINISTRATOR') && isAdministratorUserUpdate();
    }

    match /events/{eventId} {
      allow get: if isAuthorised('OPERATOR');

      match /registrations/{registrationId} {
        // Reads
        allow get: if isAuthorised('OPERATOR');
        allow list: if isAuthorised('MEDIATOR');

        // Writes — admins inherit both Operator and Mediator paths via level
        // thresholds, plus exclusive delete below.
        allow create: if false;
        allow update: if isCurrentEvent(eventId) && (
          (isAuthorised('OPERATOR') && isOperatorReceptionUpdate()) ||
          (isAuthorised('MEDIATOR') && isMediatorUpdate())
        );
        allow delete: if isCurrentEvent(eventId) && isAuthorised('ADMINISTRATOR');
      }
    }

    match /claims/{claimId} {
      allow get, list: if isAuthorised('MEDIATOR');

      allow create: if isAuthorised('MEDIATOR')
        && isValidClaim()
        && request.resource.data.claimed_at == request.time;

      allow update: if isAuthorised('MEDIATOR')
        && isValidClaim()
        && (request.resource.data.claimed_at == resource.data.claimed_at
          || request.resource.data.claimed_at == request.time)
        && (
          resource.data.status == 'COMPLETED'
          || resource.data.claimed_by.email == request.auth.token.email
          || resource.data.claimed_at < request.time - duration.value(1800, 's')
        );

      allow delete: if isAuthorised('MEDIATOR')
        && resource.data.status == 'CLAIMED'
        && resource.data.claimed_by.email == request.auth.token.email;
    }

    // ─── Functions ───────────────────────────────────────────────────────────

    // -- Auth -----------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function accessLevelValue(level) {
      return level == 'OPERATOR' ? 1 :
        level == 'MEDIATOR' ? 2 :
        level == 'ADMINISTRATOR' ? 3 : 0;
    }

    function isAuthorised(level) {
      return isSignedIn()
        && exists(userPath())
        && get(userPath()).data.access_level is int
        && get(userPath()).data.access_expires is timestamp
        && get(userPath()).data.access_level >= accessLevelValue(level)
        && get(userPath()).data.access_expires >= request.time;
    }

    // Administrator user updates are disabled until the rollout is ready.
    // function isAdministratorUserUpdate() {
    //   let changed = request.resource.data.diff(resource.data).affectedKeys();
    //   return changed.hasAll(['updated_at'])
    //     && changed.hasAny(['access_level', 'access_expires'])
    //     && changed.hasOnly(['access_level', 'access_expires', 'updated_at'])
    //     && request.resource.data.access_level is int
    //     && request.resource.data.access_level >= 0
    //     && request.resource.data.access_level <= 3
    //     && request.resource.data.access_expires is timestamp
    //     && request.resource.data.updated_at == request.time;
    // }

    // -- Events ---------------------------------------------------------------

    function isCurrentEvent(eventId) {
      return eventId >= '2026';
    }

    // -- Operator reception update --------------------------------------------

    function isOperatorReceptionUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let appendsUpdate = isValidUpdatesChange();
      return changed.hasAll(['status', 'updated_at', 'updates'])
        && changed.hasOnly(['status', 'arrived_at', 'updated_at', 'updates'])
        && request.resource.data.updated_at == request.time
        && (
          isOperatorCheckIn(changed, appendsUpdate)
          || isOperatorRejection(changed, appendsUpdate)
          || isOperatorConflict(changed, appendsUpdate)
        );
    }

    function isOperatorCheckIn(changed, appendsUpdate) {
      return request.resource.data.status == 'CHECKED_IN'
        && changed.hasAll(['arrived_at'])
        && request.resource.data.arrived_at == request.time
        && appendsUpdate;
    }

    function isOperatorRejection(changed, appendsUpdate) {
      return request.resource.data.status == 'REJECTED'
        && !changed.hasAny(['arrived_at'])
        && appendsUpdate;
    }

    function isOperatorConflict(changed, appendsUpdate) {
      return request.resource.data.status == 'CONFLICT'
        && !changed.hasAny(['arrived_at'])
        && appendsUpdate;
    }

    // -- Mediator update -------------------------------------------------------

    function isMediatorUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAll(['updated_at', 'updates'])
        && changed.hasOnly([
          'full_name',
          'comments',
          'email',
          'contact_number',
          'graduating_year',
          'search_ngrams',
          'status',
          'arrived_at',
          'updated_at',
          'updates',
        ])
        && request.resource.data.updated_at == request.time
        && isValidUpdatesChange()
        // A rebuilt index can equal the stored one when an edit introduces no
        // new 1-3 character grams, so require validity rather than a change.
        && (!changed.hasAny(['full_name', 'contact_number', 'email'])
          || isValidSearchNgrams(request.resource.data.get('search_ngrams', [])))
        && (!changed.hasAny(['full_name']) || isValidName(request.resource.data.full_name))
        && (!changed.hasAny(['comments']) || isValidComments(request.resource.data.comments))
        && (!changed.hasAny(['email']) || isValidEmail(request.resource.data.email))
        && (!changed.hasAny(['contact_number']) || isValidContactNumber(request.resource.data.contact_number))
        && (!changed.hasAny(['graduating_year']) || isValidGraduatingYear(request.resource.data.graduating_year))
        && (!changed.hasAny(['search_ngrams']) || isValidSearchNgrams(request.resource.data.search_ngrams))
        && (!changed.hasAny(['status']) || isValidStatus(request.resource.data.status))
        && (!changed.hasAny(['arrived_at']) || isValidArrival(request.resource.data.arrived_at));
    }

    // -- Field validators -----------------------------------------------------

    function isValidName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function isValidComments(value) {
      return value is string && value.size() <= 10000;
    }

    function isValidEmail(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 254
        && value.matches('^.+@.+\\..+$');
    }

    function isValidContactNumber(value) {
      return value is string && value.matches('^[89][0-9]{7}$');
    }

    function isValidGraduatingYear(value) {
      return value is string && value.matches('^[0-9]{4}$');
    }

    function isValidSearchNgrams(value) {
      return value is list
        && value.size() > 0
        && value.size() <= 1500
        && value[0] is string
        && value.toSet().size() == value.size();
    }

    function isValidStatus(value) {
      return value in ['REGISTERED', 'CHECKED_IN', 'CONFLICT', 'REJECTED'];
    }

    function isValidArrival(value) {
      return value == null || value is timestamp;
    }

    // -- Updates log ----------------------------------------------------------

    function isValidUpdatesChange() {
      let existingUpdates = resource.data.get('updates', []);
      let nextUpdates = request.resource.data.get('updates', []);
      return nextUpdates is list
        && existingUpdates is list
        && nextUpdates.size() == existingUpdates.size() + 1
        && isValidUpdateEntry(nextUpdates[nextUpdates.size() - 1]);
    }

    function isValidUpdateEntry(entry) {
      return entry is map
        && entry.action in ['CHECKED_IN', 'REJECTED', 'CONFLICT', 'UPDATED']
        && entry.by is map
        && entry.by.name is string
        && entry.by.name.size() <= 120
        && entry.by.email is string
        && entry.by.email == request.auth.token.email
        && entry.at is timestamp
        && entry.details is string
        && entry.details.size() <= 1000;
    }

    // -- Claims --------------------------------------------------------------

    function isValidClaim() {
      let data = request.resource.data;
      let completed = data.status == 'COMPLETED';
      return data.keys().hasOnly([
        'teacher', 'status', 'claimed_by', 'claimed_at',
        'completed_by', 'completed_at', 'updated_at',
      ])
        && data.teacher is string
        && data.teacher.size() > 0
        && data.teacher.size() <= 120
        && data.status in ['CLAIMED', 'COMPLETED']
        && data.claimed_by is map
        && data.claimed_by.email is string
        && data.claimed_by.email == request.auth.token.email
        && data.claimed_by.name is string
        && data.claimed_by.name.size() <= 120
        && data.claimed_at is timestamp
        && data.updated_at is timestamp
        && data.updated_at == request.time
        && (completed
          ? data.completed_by is map
            && data.completed_by.email is string
            && data.completed_by.email == request.auth.token.email
            && data.completed_by.name is string
            && data.completed_by.name.size() <= 120
            && data.completed_at is timestamp
            && data.completed_at == request.time
          : data.completed_by == null && data.completed_at == null);
    }
  }
}
