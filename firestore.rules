rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow get: if isAuthorised(1);

      match /registrations/{registrationId} {
        allow create: if false;
        allow get: if isAuthorised(1);
        allow list: if isAuthorised(2);
        allow update: if isMediatorUpdate(eventId) || isOperatorReceptionUpdate(eventId);
      }
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAuthorised(minimumAccessLevel) {
      return isSignedIn()
        && exists(userPath())
        && get(userPath()).data.access_level is int
        && get(userPath()).data.access_expires is timestamp
        && get(userPath()).data.access_level >= minimumAccessLevel
        && get(userPath()).data.access_expires >= request.time;
    }

    function isMediatorUpdate(eventId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthorised(2)
        && changed.hasOnly([
          'full_name',
          'contact_number',
          'graduating_year',
          'visiting_teachers',
          'comments',
          'status',
          'arrived_at',
          'updated_at'
        ])
        && changed.hasAll(['updated_at'])
        && request.resource.data.updated_at == request.time
        && (!changed.hasAny(['full_name']) || isValidName(request.resource.data.full_name))
        && (!changed.hasAny(['contact_number']) || isValidContactNumber(eventId, request.resource.data.contact_number))
        && (!changed.hasAny(['graduating_year']) || isValidGraduatingYear(eventId, request.resource.data.graduating_year))
        && (!changed.hasAny(['visiting_teachers']) || isValidVisitingTeachers(eventId, request.resource.data.visiting_teachers))
        && (!changed.hasAny(['comments']) || isValidComments(request.resource.data.comments))
        && (!changed.hasAny(['status']) || isValidStatus(request.resource.data.status))
        && (!changed.hasAny(['arrived_at']) || isValidArrival(eventId, request.resource.data.arrived_at));
    }

    function isOperatorReceptionUpdate(eventId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthorised(1)
        && changed.hasAll(['status', 'updated_at'])
        && request.resource.data.updated_at == request.time
        && (
          isOperatorCheckIn(eventId, changed)
          || isOperatorRejection(changed)
          || isOperatorConflict(changed)
        );
    }

    function isOperatorCheckIn(eventId, changed) {
      return request.resource.data.status == 'CHECKED_IN'
        && changed.hasOnly(['status', 'arrived_at', 'updated_at'])
        && (
          (eventId == '2025' && !changed.hasAny(['arrived_at']))
          || (
            eventId != '2025'
            && changed.hasAll(['arrived_at'])
            && request.resource.data.arrived_at == request.time
          )
        );
    }

    function isOperatorRejection(changed) {
      return request.resource.data.status == 'REJECTED'
        && changed.hasOnly(['status', 'updated_at']);
    }

    function isOperatorConflict(changed) {
      return request.resource.data.status == 'CONFLICT'
        && changed.hasOnly(['status', 'comments', 'updated_at'])
        && changed.hasAll(['comments'])
        && isValidComments(request.resource.data.comments);
    }

    function isValidName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function isValidComments(value) {
      return value is string && value.size() <= 10000;
    }

    function isValidStatus(value) {
      return value in ['REGISTERED', 'CHECKED_IN', 'CONFLICT', 'REJECTED'];
    }

    function isValidContactNumber(eventId, value) {
      return (eventId == '2025' && value is int)
        || (eventId != '2025' && value is string && value.size() > 0 && value.size() <= 30);
    }

    function isValidGraduatingYear(eventId, value) {
      return (eventId == '2025' && value is int)
        || (eventId != '2025' && value is string && value.size() > 0 && value.size() <= 20);
    }

    function isValidVisitingTeachers(eventId, value) {
      return (eventId == '2026' && isValidTeacherList(value))
        || (eventId != '2026' && value is string && value.size() <= 1000);
    }

    function isValidArrival(eventId, value) {
      return eventId != '2025' && (value == null || value is timestamp);
    }

    function isValidTeacherList(value) {
      let listTypeOk = value is list;
      let listMinSizeOk = value.size() > 0;
      let listMaxSizeOk = value.size() <= 20;
      let listUniqueOk = value.toSet().size() == value.size();
      let firstRangeOk = areValidTeachers0To9(value);
      let secondRangeOk = areValidTeachers10To19(value);
      return listTypeOk
        && listMinSizeOk
        && listMaxSizeOk
        && listUniqueOk
        && firstRangeOk
        && secondRangeOk;
    }

    function areValidTeachers0To9(value) {
      let teacher0Ok = value.size() <= 0 || (value[0] is string && value[0].matches('^.{1,120}$'));
      let teacher1Ok = value.size() <= 1 || (value[1] is string && value[1].matches('^.{1,120}$'));
      let teacher2Ok = value.size() <= 2 || (value[2] is string && value[2].matches('^.{1,120}$'));
      let teacher3Ok = value.size() <= 3 || (value[3] is string && value[3].matches('^.{1,120}$'));
      let teacher4Ok = value.size() <= 4 || (value[4] is string && value[4].matches('^.{1,120}$'));
      let teacher5Ok = value.size() <= 5 || (value[5] is string && value[5].matches('^.{1,120}$'));
      let teacher6Ok = value.size() <= 6 || (value[6] is string && value[6].matches('^.{1,120}$'));
      let teacher7Ok = value.size() <= 7 || (value[7] is string && value[7].matches('^.{1,120}$'));
      let teacher8Ok = value.size() <= 8 || (value[8] is string && value[8].matches('^.{1,120}$'));
      let teacher9Ok = value.size() <= 9 || (value[9] is string && value[9].matches('^.{1,120}$'));
      return teacher0Ok
        && teacher1Ok
        && teacher2Ok
        && teacher3Ok
        && teacher4Ok
        && teacher5Ok
        && teacher6Ok
        && teacher7Ok
        && teacher8Ok
        && teacher9Ok;
    }

    function areValidTeachers10To19(value) {
      let teacher10Ok = value.size() <= 10 || (value[10] is string && value[10].matches('^.{1,120}$'));
      let teacher11Ok = value.size() <= 11 || (value[11] is string && value[11].matches('^.{1,120}$'));
      let teacher12Ok = value.size() <= 12 || (value[12] is string && value[12].matches('^.{1,120}$'));
      let teacher13Ok = value.size() <= 13 || (value[13] is string && value[13].matches('^.{1,120}$'));
      let teacher14Ok = value.size() <= 14 || (value[14] is string && value[14].matches('^.{1,120}$'));
      let teacher15Ok = value.size() <= 15 || (value[15] is string && value[15].matches('^.{1,120}$'));
      let teacher16Ok = value.size() <= 16 || (value[16] is string && value[16].matches('^.{1,120}$'));
      let teacher17Ok = value.size() <= 17 || (value[17] is string && value[17].matches('^.{1,120}$'));
      let teacher18Ok = value.size() <= 18 || (value[18] is string && value[18].matches('^.{1,120}$'));
      let teacher19Ok = value.size() <= 19 || (value[19] is string && value[19].matches('^.{1,120}$'));
      return teacher10Ok
        && teacher11Ok
        && teacher12Ok
        && teacher13Ok
        && teacher14Ok
        && teacher15Ok
        && teacher16Ok
        && teacher17Ok
        && teacher18Ok
        && teacher19Ok;
    }
  }
}
